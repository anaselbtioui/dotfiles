# Single source of truth for every color in this setup.
#
# Values are copied verbatim from modus-themes-vivendi-tinted-palette in
# protesilaos/modus-themes (GNU Emacs). That palette is designed so every
# foreground/background pair meets WCAG AAA, a minimum 7:1 relative luminance
# ratio, and its stated doctrine is to avoid the "rainbow effect" by using as
# few colors as necessary. Terminal slots follow the project's own
# bg-term-*/fg-term-* mappings, not a hand-rolled guess.
#
# Verify any edit with scripts/check-contrast.py before committing.

BG_MAIN=#0d0e1c
BG_DIM=#1d2235
BG_INACTIVE=#2b3045
BG_ACTIVE=#4a4f69
BG_REGION=#555a66
BG_POPUP=#14162c
BG_HL_LINE=#303a6f
BORDER=#61647a

FG_MAIN=#ffffff
FG_DIM=#989898
FG_ALT=#c6daff

# ANSI 0-7
TERM_BLACK=#000000
TERM_RED=#ff5f59
TERM_GREEN=#44bc44
TERM_YELLOW=#d0bc00
TERM_BLUE=#2fafff
TERM_MAGENTA=#feacd0
TERM_CYAN=#00d3d0
TERM_WHITE=#a6a6a6

# ANSI 8-15
TERM_BLACK_BRIGHT=#595959
TERM_RED_BRIGHT=#ff6b55
TERM_GREEN_BRIGHT=#11c777
TERM_YELLOW_BRIGHT=#fec43f
TERM_BLUE_BRIGHT=#79a8ff
TERM_MAGENTA_BRIGHT=#b6a0ff
TERM_CYAN_BRIGHT=#6ae4b9
TERM_WHITE_BRIGHT=#ffffff

# Deviation from upstream: Modus maps the cursor to magenta-intense (#ff66ff),
# which suits a thin Emacs cursor but fills an entire cell in a terminal block
# cursor. Uses magenta-cooler instead, same hue family, lower intensity.
CURSOR=#b6a0ff

# Semantic states, the only colors allowed to carry meaning in the UI.
STATE_ERROR=#ff5f59
STATE_WARNING=#d0bc00
STATE_SUCCESS=#44bc44
STATE_INFO=#2fafff
