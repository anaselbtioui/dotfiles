font-family = Iosevka Quiet
font-size = 12
adjust-cell-height = 10%

# Colors come from palette/modus-vivendi-tinted.env, verified by
# scripts/check-contrast.py. Do not edit them here alone.
background = #0d0e1c
foreground = #ffffff
cursor-color = #b6a0ff
selection-background = #555a66
selection-foreground = #ffffff

palette = 0=#000000
palette = 1=#ff5f59
palette = 2=#44bc44
palette = 3=#d0bc00
palette = 4=#2fafff
palette = 5=#feacd0
palette = 6=#00d3d0
palette = 7=#a6a6a6
palette = 8=#595959
palette = 9=#ff6b55
palette = 10=#11c777
palette = 11=#fec43f
palette = 12=#79a8ff
palette = 13=#b6a0ff
palette = 14=#6ae4b9
palette = 15=#ffffff

window-theme = ghostty
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true

cursor-style = block
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
