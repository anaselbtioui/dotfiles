# Quiet notifications. Overlay chrome, match fuzzel / waybar radius.

font=Ubuntu Sans 11
background-color=#14162ca6
text-color=#ffffff
border-color=#ffffff1a
border-size=1
border-radius=8
padding=12
margin=12
default-timeout=4000
width=360
anchor=top-right
outer-margin=12,12,12,12
max-icon-size=32

[urgency=low]
text-color=#989898
border-color=#2b3045

[urgency=critical]
border-color=#ff5f59
text-color=#ffffff
default-timeout=0
